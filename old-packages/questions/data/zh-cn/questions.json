    "keyed": "plus",
    "domain": "A",
    "facet": 1,
    "ipipId": [
      "H113",
      "X6"
    ]
  },
  {
    "id": "c7f53c3c-2e77-432f-bb71-7470b67d3aa9",
    "text": "能成功完成任务",
    "keyed": "plus",
    "domain": "C",
    "facet": 1,
    "ipipId": [
      "H1285"
    ]
  },
  {
    "id": "48ad12ce-470e-4339-90ac-ea8c43a0103e",
    "text": "很容易生气",
    "keyed": "plus",
    "domain": "N",
    "facet": 2,
    "ipipId": [
      "H754",
      "X18"
    ]
  },
  {
    "id": "458f3957-2359-4077-ade1-34525d633063",
    "text": "喜欢参加大型聚会",
    "keyed": "plus",
    "domain": "E",
    "facet": 2,
    "ipipId": [
      "H78",
      "X17"
    ]
  },
  {
    "id": "58d571e5-d725-4cf8-a438-32c16ee28eb6",
    "text": "认为艺术是很重要的",
    "keyed": "plus",
    "domain": "O",
    "facet": 2,
    "ipipId": [
      "X123"
    ]
  },
  {
    "id": "0cf79e27-e702-45c2-9471-04ac96b58e0e",
    "text": "会利用他人来达成自己的目的",
    "keyed": "minus",
    "domain": "A",
    "facet": 2,
    "ipipId": [
      "H416",
      "X24"
    ]
  },
  {
    "id": "cda1ca17-b599-4561-a6cd-ff9d36062d27",
    "text": "喜欢整洁",
    "keyed": "plus",
    "domain": "C",
    "facet": 2,
    "ipipId": [
      "H244",
      "X21"
    ]
  },
  {
    "id": "5e8550d7-b8ef-4905-950a-f81d735d39e2",
    "text": "时常感到忧郁",
    "keyed": "plus",
    "domain": "N",
    "facet": 3,
    "ipipId": [
      "X74"
    ]
  },
  {
    "id": "8af754f2-68e9-48f3-8c5d-2e6633d4472c",
    "text": "承担责任",
    "keyed": "plus",
    "domain": "E",
    "facet": 3,
    "ipipId": [
      "H334",
      "X27"
    ]
  },
  {
    "id": "0727def6-3d18-4221-bf38-86b58f9f3eed",
    "text": "能强烈感受到自己的情绪",
    "keyed": "plus",
    "domain": "O",
    "facet": 3,
    "ipipId": [
      "X92"
    ]
  },
  {
    "id": "ccf3a5c8-fb50-4bd4-8e7a-22af3d657279",
    "text": "乐于帮助他人",
    "keyed": "plus",
    "domain": "A",
    "facet": 3,
    "ipipId": [
      "H1108"
    ]
  },
  {
    "id": "73d84e5d-cbf5-47f0-b8cb-4d2159a52e32",
    "text": "信守承诺",
    "keyed": "plus",
    "domain": "C",
    "facet": 3,
    "ipipId": [
      "H149",
      "X33",
      "V14"
    ]
  },
  {
    "id": "b2d9ef74-73f5-4ea8-b00c-7aaca15937df",
    "text": "感觉自己很难接近别人",
    "keyed": "plus",
    "domain": "N",
    "facet": 4,
    "ipipId": [
      "H592"
    ]
  },
  {
    "id": "48a761ef-438e-409b-ae59-ea2ce8f84414",
    "text": "总是很忙碌",
    "keyed": "plus",
    "domain": "E",
    "facet": 4,
    "ipipId": [
      "H58"
    ]
  },
  {
    "id": "cae55842-8957-4e3b-83b3-ceff98fb9dcf",
    "text": "相比墨守成规，我更喜欢有变化。",
    "keyed": "plus",
    "domain": "O",
    "facet": 4,
    "ipipId": [
      "X204"
    ]
  },
  {
    "id": "e2028ad3-b128-4f76-be57-398bfe2aff22",
    "text": "喜欢和别人比试",
    "keyed": "minus",
    "domain": "A",
    "facet": 4,
    "ipipId": [
      "H453"
    ]
  },
  {
    "id": "b7fc949b-02b6-4cb9-a3e2-dbb3d824b55f",
    "text": "工作努力",
    "keyed": "plus",
    "domain": "C",
    "facet": 4,
    "ipipId": [
      "H1206",
      "X44"
    ]
  },
  {
    "id": "481efd08-c810-43b1-a952-f8ac9052f96b",
    "text": "大吃大喝寻欢作乐",
    "keyed": "plus",
    "domain": "N",
    "facet": 5,
    "ipipId": [
      "X133"
    ]
  },
  {
    "id": "987efee2-899f-4a65-b9b5-1589ef0460d7",
    "text": "喜欢追求刺激",
    "keyed": "plus",
    "domain": "E",
    "facet": 5,
    "ipipId": [
      "H438",
      "X50"
    ]
  },
  {
    "id": "e1e804c7-4a1d-498f-8610-f95147af9d1d",
    "text": "喜欢阅读有挑战性的材料",
    "keyed": "plus",
    "domain": "O",
    "facet": 5,
    "ipipId": [
      "X211"
    ]
  },
  {
    "id": "71029381-3908-4c68-91e1-e41fb45542a2",
    "text": "相信自己比别人更好",
    "keyed": "minus",
    "domain": "A",
    "facet": 5,
    "ipipId": [
      "H736",
      "X61"
    ]
  },
  {
    "id": "f6076eea-56ae-4b46-97f1-5f94a7676c96",
    "text": "我总是有所准备",
    "keyed": "plus",
    "domain": "C",
    "facet": 5,
    "ipipId": [
      "X87"
    ]
  },
  {
    "id": "2f519935-92e8-48ad-9746-4a0f8b38466a",
    "text": "容易慌张",
    "keyed": "plus",
    "domain": "N",
    "facet": 6,
    "ipipId": [
      "H948",
      "X64"
    ]
  },
  {
    "id": "899c3f66-51d0-46ea-963a-6fc36d3b3cb9",
    "text": "我的快乐会感染周围的人",
    "keyed": "plus",
    "domain": "E",
    "facet": 6,
    "ipipId": [
      "H32",
      "X63"
    ]
  },
  {
    "id": "79186f48-e7fa-4df4-b74b-b0627ee244e1",
    "text": "认为自己在政治方面非常自由开放",
    "keyed": "plus",
    "domain": "O",
    "facet": 6,
    "ipipId": [
      "X218"
    ]
  },
  {
    "id": "fd50e1ca-d9e0-4037-a7a1-a191d4db2d96",
    "text": "同情流浪汉",
    "keyed": "plus",
    "domain": "A",
    "facet": 6,
    "ipipId": [
      "X259"
    ]
  },
  {
    "id": "bd9eec0a-b68b-472c-8803-7db29c308cdb",
    "text": "会不经过思考就开始行动",
    "keyed": "minus",
    "domain": "C",
    "facet": 6,
    "ipipId": [
      "E46"
    ]
  },
  {
    "id": "7f92ab2c-265c-4b84-8c74-09f9bb9d41a7",
    "text": "担心会发生最糟糕的情况",
    "keyed": "plus",
    "domain": "N",
    "facet": 1,
    "ipipId": [
      "H999"
    ]
  },
  {
    "id": "af55f014-788c-4b6e-92c4-b2b59dc8a28d",
    "text": "和其他人待在一起时，我觉得很自在",
    "keyed": "plus",
    "domain": "E",
    "facet": 1,
    "ipipId": [
      "X112"
    ]
  },
  {
    "id": "08ff6dca-02a5-4aeb-aaa4-2ecf2526f143",
    "text": "喜欢天马行空地幻想",
    "keyed": "plus",
    "domain": "O",
    "facet": 1,
    "ipipId": [
      "X238"
    ]
  },
  {
    "id": "6f66cdc0-9044-457b-b40d-501ecae15ee7",
    "text": "相信他人的出发点是好的",
    "keyed": "plus",
    "domain": "A",
    "facet": 1,
    "ipipId": [
      "H549"
    ]
  },
  {
    "id": "f110fc66-2e9e-413c-920b-19f05e63d7ac",
    "text": "在自己所从事的领域出类拔萃",
    "keyed": "plus",
    "domain": "C",
    "facet": 1,
    "ipipId": [
      "H1174",
      "X8"
    ]
  },
  {
    "id": "7dab2a37-8635-4fc7-86b7-0abf13c183c9",
    "text": "容易被激怒",
    "keyed": "plus",
    "domain": "N",
    "facet": 2,
    "ipipId": [
      "H761"
    ]
  },
  {
    "id": "28ab59a0-e7cd-4fce-94e3-bba2ecc023b6",
    "text": "在聚会上，我会和很多不同的人交谈",
    "keyed": "plus",
    "domain": "E",
    "facet": 2,
    "ipipId": [
      "X83"
    ]
  },
  {
    "id": "b5919f2f-cded-4745-a9ce-c02703cee807",
    "text": "我能发现别人看不到的美",
    "keyed": "plus",
    "domain": "O",
    "facet": 2,
    "ipipId": [
      "E105"
    ]
  },
  {
    "id": "5a5fa975-d024-4ac8-8845-2823f957c21b",
    "text": "为了领先别人，我会采用作弊的方式",
    "keyed": "minus",
    "domain": "A",
    "facet": 2,
    "ipipId": [
      "X198"
    ]
  },
  {
    "id": "adf33f9f-45bd-43e3-af25-4c491176d97f",
    "text": "经常忘记把东西放回原处",
    "keyed": "minus",
    "domain": "C",
    "facet": 2,
    "ipipId": [
      "X82"
    ]
  },
  {
    "id": "f0a14e16-d726-47e9-a2c1-647fd3d7d52e",
    "text": "不喜欢自己",
    "keyed": "plus",
    "domain": "N",
    "facet": 3,
    "ipipId": [
      "X15"
    ]
  },
  {
    "id": "0b38e3d3-c15c-454c-b034-f4eb7ae1580a",
    "text": "我会尝试去领导他人",
    "keyed": "plus",
    "domain": "E",
    "facet": 3,
    "ipipId": [
      "H524"
    ]
  },
  {
    "id": "5631b856-ff34-4f76-a0cd-edc7104c3bfa",
    "text": "能感受到他人的情绪",
    "keyed": "plus",
    "domain": "O",
    "facet": 3,
    "ipipId": [
      "E136"
    ]
  },
  {
    "id": "ada867af-4db1-4e3d-a604-2b695c1806e5",
    "text": "关心他人",
    "keyed": "plus",
    "domain": "A",
    "facet": 3,
    "ipipId": [
      "H1100",
      "X31"
    ]
  },
  {
    "id": "c55e3958-00c4-4fc3-9118-47d8f31bfde1",
    "text": "我会实话实说",
    "keyed": "plus",
    "domain": "C",
    "facet": 3,
    "ipipId": [
      "H145"
    ]
  },
  {
    "id": "acd8fadc-5399-4a67-b5ff-9d1ada049c01",
    "text": "害怕引起他人的注意",
    "keyed": "plus",
    "domain": "N",
    "facet": 4,
    "ipipId": [
      "H655"
    ]
  },
  {
    "id": "d07b6c67-0d02-4948-a997-bb84ac234cd8",
    "text": "总是在奔波",
    "keyed": "plus",
    "domain": "E",
    "facet": 4,
    "ipipId": [
      "H54",
      "X40"
    ]
  },
  {
    "id": "33b81fd0-7e32-4cd8-a13a-d5f5f754f998",
    "text": "我更喜欢做自己熟悉的事情",
    "keyed": "minus",
    "domain": "O",
    "facet": 4,
    "ipipId": [
      "X30"
    ]
  },
  {
    "id": "d9a9a180-29c9-4ec5-8621-2256d411def7",
    "text": "会冲人大喊大叫",
    "keyed": "minus",
    "domain": "A",
    "facet": 4,
    "ipipId": [
      "H809"
    ]
  },
  {
    "id": "f12c3d9d-1d12-4aa6-ad2e-009cd0651cbb",
    "text": "我会超出预期地完成任务或工作",
    "keyed": "plus",
    "domain": "C",
    "facet": 4,
    "ipipId": [
      "H2014"
    ]
  },
  {
    "id": "9891b7ba-a494-4307-aafe-301d8db506c6",
    "text": "很少过度放纵自己",
    "keyed": "minus",
    "domain": "N",
    "facet": 5,
    "ipipId": [
      "X181"
    ]
  },
  {
    "id": "f1675af6-88bf-4376-a946-0281e762b39c",
    "text": "喜欢冒险",
    "keyed": "plus",
    "domain": "E",
    "facet": 5,
    "ipipId": [
      "H446"
    ]
  },
  {
    "id": "95a3f20c-f933-4d19-a2c1-a7dbdf63c562",
    "text": "会避免参与关于哲学的讨论",
    "keyed": "minus",
    "domain": "O",
    "facet": 5,
    "ipipId": [
      "X248"
    ]
  },
  {
    "id": "7df44711-4cd4-4b05-8830-73fcc3ebdab5",
    "text": "觉得自己很了不起",
    "keyed": "minus",
    "domain": "A",
    "facet": 5,
    "ipipId": [
      "H2043"
    ]
  },
  {
    "id": "9d3cb5c7-955c-43a4-b6c7-b07ed01dcbd9",
    "text": "能执行自己制定的计划",
    "keyed": "plus",
    "domain": "C",
    "facet": 5,
    "ipipId": [
      "H258"
    ]
  },
  {
    "id": "13c58810-3864-42ba-aa87-d4166f858756",
    "text": "感到被各种事情压得喘不过气来",
    "keyed": "plus",
    "domain": "N",
    "facet": 6,
    "ipipId": [
      "H959"
    ]
  },
  {
    "id": "961376e0-16a1-4c14-b059-789e63d11b63",
    "text": "我的生活很快乐",
    "keyed": "plus",
    "domain": "E",
    "facet": 6,
    "ipipId": [
      "H1094"
    ]
  },
  {
    "id": "f08e1b27-3673-4898-9cae-896482d0d9f9",
    "text": "相信没有绝对的对错之分",
    "keyed": "plus",
    "domain": "O",
    "facet": 6,
    "ipipId": [
      "X184"
    ]
  },
  {
    "id": "c2038c12-7a37-47a8-9983-831bd6692aab",
    "text": "我同情那些处境不如自己的人",
    "keyed": "plus",
    "domain": "A",
    "facet": 6,
    "ipipId": [
      "E115"
    ]
  },
  {
    "id": "956f3e17-ff17-4af5-a52f-9222b8968106",
    "text": "会做出草率的决定",
    "keyed": "minus",
    "domain": "C",
    "facet": 6,
    "ipipId": [
      "H853"
    ]
  },
  {
    "id": "4d81238b-5407-47d4-88e5-dc0e38aa14f5",
    "text": "对很多事情感到害怕",
    "keyed": "plus",
    "domain": "N",
    "facet": 1,
    "ipipId": [
      "H968"
    ]
  },
  {
    "id": "9f9166f0-fa94-4c14-a91d-3eecd8395794",
    "text": "避免和他人接触",
    "keyed": "minus",
    "domain": "E",
    "facet": 1,
    "ipipId": [
      "H648"
    ]
  },
  {
    "id": "23a1034f-fab7-4887-a66e-5ef4eaafb25e",
    "text": "喜欢做白日梦",
    "keyed": "plus",
    "domain": "O",
    "facet": 1,
    "ipipId": [
      "X71"
    ]
  },
  {
    "id": "c63e6121-c3ed-40cc-abc2-c1e6ea1e0858",
    "text": "相信他人说的话",
    "keyed": "plus",
    "domain": "A",
    "facet": 1,
    "ipipId": [
      "E157"
    ]
  },
  {
    "id": "02ee1930-36a7-4caa-b10c-c93efb682a44",
    "text": "能轻松完成任务",
    "keyed": "plus",
    "domain": "C",
    "facet": 1,
    "ipipId": [
      "H1354"
    ]
  },
  {
    "id": "da8e6ed1-2296-4c58-8fdb-66f2f591989b",
    "text": "发脾气",
    "keyed": "plus",
    "domain": "N",
    "facet": 2,
    "ipipId": [
      "H755"
    ]
  },
  {
    "id": "03c10b30-b88f-4c63-8acc-71251ca24615",
    "text": "更喜欢一个人独处",
    "keyed": "minus",
    "domain": "E",
    "facet": 2,
    "ipipId": [
      "H587"
    ]
  },
  {
    "id": "751a04bc-5adf-485a-8ea4-4308406ae85b",
    "text": "不喜欢诗歌",
    "keyed": "minus",
    "domain": "O",
    "facet": 2,
    "ipipId": [
      "X45"
    ]
  },
  {
    "id": "982e83c2-d34e-48da-9c71-78494ab05c85",
    "text": "占别人的便宜",
    "keyed": "minus",
    "domain": "A",
    "facet": 2,
    "ipipId": [
      "H427",
      "V109"
    ]
  },
  {
    "id": "f4891687-0ff0-47af-a4f6-d1202c8f6676",
    "text": "我的房间很乱",
    "keyed": "minus",
    "domain": "C",
    "facet": 2,
    "ipipId": [
      "H822",
      "X16"
    ]
  },
  {
    "id": "743d8973-1de1-4485-91b4-8a5cf63e7d44",
    "text": "经常情绪低落",
    "keyed": "plus",
    "domain": "N",
    "facet": 3,
    "ipipId": [
      "H640"
    ]
  },
  {
    "id": "2452f034-8273-4f71-9122-a40f5ead31ba",
    "text": "掌控局面",
    "keyed": "plus",
    "domain": "E",
    "facet": 3,
    "ipipId": [
      "H325"
    ]
  },
  {
    "id": "2a300001-6e05-4c79-b8b5-2ccae4c3d463",
    "text": "很少察觉到自己的情绪反应",
    "keyed": "minus",
    "domain": "O",
    "facet": 3,
    "ipipId": [
      "X10"
    ]
  },
  {
    "id": "cd54bd76-ca9c-4030-b325-bb8d896bcb3f",
    "text": "对他人的感受漠不关心",
    "keyed": "minus",
    "domain": "A",
    "facet": 3,
    "ipipId": [
      "X203"
    ]
  },
  {
    "id": "4e6e3a34-176f-4e6e-8730-1341611f972b",
    "text": "破坏规则",
    "keyed": "minus",
    "domain": "C",
    "facet": 3,
    "ipipId": [
      "H1346"
    ]
  },
  {
    "id": "20062533-a33d-4c1e-9cd9-bff868015b3f",
    "text": "只有和朋友在一起的时候我才会感到自在",
    "keyed": "plus",
    "domain": "N",
    "facet": 4,
    "ipipId": [
      "H656"
    ]
  },
  {
    "id": "b2a077d5-1fe0-4b06-ab63-35455e001e54",
    "text": "我的闲暇时间非常充实",
    "keyed": "plus",
    "domain": "E",
    "facet": 4,
    "ipipId": [
      "H79"
    ]
  },
  {
    "id": "0d2e65ab-95d9-482f-beb4-3239a3a4944a",
    "text": "不喜欢改变",
    "keyed": "minus",
    "domain": "O",
    "facet": 4,
    "ipipId": [
      "H1063",
      "X43"
    ]
  },
  {
    "id": "0de0f900-cede-4538-9c00-5da4f830b028",
    "text": "侮辱他人",
    "keyed": "minus",
    "domain": "A",
    "facet": 4,
    "ipipId": [
      "H1103"
    ]
  },
  {
    "id": "a9c97d6b-6721-4150-8d84-64ef3082f164",
    "text": "在工作或学习上，我不会多做，过得去就行",
    "keyed": "minus",
    "domain": "C",
    "facet": 4,
    "ipipId": [
      "X115"
    ]
  },
  {
    "id": "9f2e7f90-0ca5-4ed0-9fe5-e060238a9b5e",
    "text": "能轻松抵御诱惑",
    "keyed": "minus",
    "domain": "N",
    "facet": 5,
    "ipipId": [
      "X274"
    ]
  },
  {
    "id": "7dd6cf2d-5c14-48c2-8ae5-633a7a596c71",
    "text": "喜欢不计后果地行事",
    "keyed": "plus",
    "domain": "E",
    "facet": 5,
    "ipipId": [
      "E35"
    ]
  },
  {
    "id": "fecc35f7-681e-4889-a404-4a973a3dfef0",
    "text": "理解抽象概念对我来说有些困难",
    "keyed": "minus",
    "domain": "O",
    "facet": 5,
    "ipipId": [
      "X176"
    ]
  },
  {
    "id": "1d686958-6fe7-432f-85e6-186b99e4e232",
    "text": "对自己的评价很高",
    "keyed": "minus",
    "domain": "A",
    "facet": 5,
    "ipipId": [
      "H738"
    ]
  },
  {
    "id": "c7db0ed8-df7d-49bf-942f-59e46ef743c4",
    "text": "浪费时间",
    "keyed": "minus",
    "domain": "C",
    "facet": 5,
    "ipipId": [
      "H1186",
      "X49"
    ]
  },
  {
    "id": "b7e0e393-9b21-4e0d-adf3-8f28fb5b9d87",
    "text": "感觉自己处理事情力不从心",
    "keyed": "plus",
    "domain": "N",
    "facet": 6,
    "ipipId": [
      "H954"
    ]
  },
  {
    "id": "79d956e8-1118-402a-a0e2-9380af18243e",
    "text": "热爱生活",
    "keyed": "plus",
    "domain": "E",
    "facet": 6,
    "ipipId": [
      "H33"
    ]
  },
  {
    "id": "96ba77b2-1a44-4dfd-95f9-ae4d1f714460",
    "text": "我在政治上比较保守",
    "keyed": "minus",
    "domain": "O",
    "facet": 6,
    "ipipId": [
      "X126"
    ]
  },
  {
    "id": "77f54ab4-0fba-4efb-8700-066c7490eb87",
    "text": "对别人遇到的麻烦事不感兴趣",
    "keyed": "minus",
    "domain": "A",
    "facet": 6,
    "ipipId": [
      "X227"
    ]
  },
  {
    "id": "a354cf7c-8d11-46ac-acc5-da90d2048637",
    "text": "仓促行事",
    "keyed": "minus",
    "domain": "C",
    "facet": 6,
    "ipipId": [
      "H862",
      "X101"
    ]
  },
  {
    "id": "43b03992-3f32-4ed1-a6f8-5d6d3e7ed246",
    "text": "我很容易觉得压力大",
    "keyed": "plus",
    "domain": "N",
    "facet": 1,
    "ipipId": [
      "X107"
    ]
  },
  {
    "id": "41702602-08e4-4e2b-9a19-291d9efc581a",
    "text": "和他人保持距离",
    "keyed": "minus",
    "domain": "E",
    "facet": 1,
    "ipipId": [
      "H704"
    ]
  },
  {
    "id": "935a7413-abac-4f54-9169-d1fbd39da752",
    "text": "喜欢陷入沉思",
    "keyed": "plus",
    "domain": "O",
    "facet": 1,
    "ipipId": [
      "E163"
    ]
  },
  {
    "id": "432dbde8-8756-4ff0-80d5-f47018235139",
    "text": "不相信别人",
    "keyed": "minus",
    "domain": "A",
    "facet": 1,
    "ipipId": [
      "H1195",
      "X12"
    ]
  },
  {
    "id": "5727c93f-317b-4af1-a686-77fc9fbc5033",
    "text": "知道如何完成任务",
    "keyed": "plus",
    "domain": "C",
    "facet": 1,
    "ipipId": [
      "H1333"
    ]
  },
  {
    "id": "d32bd062-4eb2-401b-99b2-e7afea39ca9b",
    "text": "不会轻易被惹恼",
    "keyed": "minus",
    "domain": "N",
    "facet": 2,
    "ipipId": [
      "X23"
    ]
  },
  {
    "id": "9a47184f-6046-4e68-a61b-3d9b357b86ea",
    "text": "避开人多的地方",
    "keyed": "minus",
    "domain": "E",
    "facet": 2,
    "ipipId": [
      "H650",
      "X22"
    ]
  },
  {
    "id": "87c5b27e-59a8-4c48-8ba8-f5413d735693",
    "text": "不喜欢去美术馆",
    "keyed": "minus",
    "domain": "O",
    "facet": 2,
    "ipipId": [
      "X235"
    ]
  },
  {
    "id": "11b20adb-abed-4363-894c-3dd823ae0540",
    "text": "给别人使坏",
    "keyed": "minus",
    "domain": "A",
    "facet": 2,
    "ipipId": [
      "H494"
    ]
  },
  {
    "id": "50418d86-712c-45d9-adc4-ea0231c93cf5",
    "text": "我的东西放得到处都是",
    "keyed": "minus",
    "domain": "C",
    "facet": 2,
    "ipipId": [
      "H823"
    ]
  },
  {
    "id": "f40e421f-6c24-4be2-bd9f-28d33358d8c6",
    "text": "对自己感到满意",
    "keyed": "minus",
    "domain": "N",
    "facet": 3,
    "ipipId": [
      "X129"
    ]
  },
  {
    "id": "8791f37b-686f-47c3-9db7-74c009951321",
    "text": "等着别人来带头",
    "keyed": "minus",
    "domain": "E",
    "facet": 3,
    "ipipId": [
      "H976"
    ]
  },
  {
    "id": "4fd25155-9cc2-4cd6-8852-3e0ca2d5e95d",
    "text": "不理解那些情绪化的人",
    "keyed": "minus",
    "domain": "O",
    "facet": 3,
    "ipipId": [
      "E156"
    ]
  },
  {
    "id": "b68af20d-24f9-4c27-85cc-fe0858994888",
    "text": "不愿为他人花费时间",
    "keyed": "minus",
    "domain": "A",
    "facet": 3,
    "ipipId": [
      "H918",
      "X170"
    ]
  },
  {
    "id": "54423933-0ebb-44a7-bdd9-2a9b100c70f2",
    "text": "违背自己的承诺",
    "keyed": "minus",
    "domain": "C",
    "facet": 3,
    "ipipId": [
      "H1018",
      "X51"
    ]
  },
  {
    "id": "7317848c-3e1b-422f-bb16-02efc504f677",
    "text": "不会被复杂的社交情境所困扰",
    "keyed": "minus",
    "domain": "N",
    "facet": 4,
    "ipipId": [
      "X209"
    ]
  },
  {
    "id": "7d93e1ca-46e8-4a30-9623-42a80c9b420c",
    "text": "喜欢慢慢来",
    "keyed": "minus",
    "domain": "E",
    "facet": 4,
    "ipipId": [
      "E113"
    ]
  },
  {
    "id": "a7f43928-8982-4ed5-8656-7a80346fe979",
    "text": "我喜欢传统的方式",
    "keyed": "minus",
    "domain": "O",
    "facet": 4,
    "ipipId": [
      "H312"
    ]
  },
  {
    "id": "17910a55-a64a-4ed0-8b46-293e2fa2fe03",
    "text": "报复别人",
    "keyed": "minus",
    "domain": "A",
    "facet": 4,
    "ipipId": [
      "H699"
    ]
  },
  {
    "id": "3890bb43-2695-4b8d-b289-ee10d11cc884",
    "text": "对工作或学业不怎么投入时间和精力",
    "keyed": "minus",
    "domain": "C",
    "facet": 4,
    "ipipId": [
      "X167"
    ]
  },
  {
    "id": "49a85680-53aa-4208-86b5-dccc7a6f8e37",
    "text": "可以控制自己的欲望",
    "keyed": "minus",
    "domain": "N",
    "facet": 5,
    "ipipId": [
      "X251"
    ]
  },
  {
    "id": "10f90fa9-649c-4631-ac4c-3dd3f751597d",
    "text": "我的行为狂放不羁",
    "keyed": "plus",
    "domain": "E",
    "facet": 5,
    "ipipId": [
      "H871"
    ]
  },
  {
    "id": "b86de003-c3c4-4cc8-9385-5ac8a0142c34",
    "text": "对理论性的讨论不感兴趣",
    "keyed": "minus",
    "domain": "O",
    "facet": 5,
    "ipipId": [
      "X239"
    ]
  },
  {
    "id": "80c1d149-7050-481a-9953-aefb441642e7",
    "text": "吹嘘自己的美德",
    "keyed": "minus",
    "domain": "A",
    "facet": 5,
    "ipipId": [
      "H746"
    ]
  },
  {
    "id": "51403620-968c-42fa-a772-65ba5ad8396f",
    "text": "拖很久才开始做一件事",
    "keyed": "minus",
    "domain": "C",
    "facet": 5,
    "ipipId": [
      "H621"
    ]
  },
  {
    "id": "88a3c2fe-3aa4-4f46-9322-da656332268a",
    "text": "在压力下能保持冷静",
    "keyed": "minus",
    "domain": "N",
    "facet": 6,
    "ipipId": [
      "X79"
    ]
  },
  {
    "id": "e7b31bdc-5f6b-40ec-ba91-f5919b0f170e",
    "text": "看到生活中好的一面",
    "keyed": "plus",
    "domain": "E",
    "facet": 6,
    "ipipId": [
      "H42"
    ]
  },
  {
    "id": "580b08d1-3c94-46e9-9d07-d6d80c698127",
    "text": "认为我们应该严惩犯罪",
    "keyed": "minus",
    "domain": "O",
    "facet": 6,
    "ipipId": [
      "X157"
    ]
  },
  {
    "id": "48bee420-60c0-45cd-be43-3893dbc1969a",
    "text": "我尽量不去想那些需要帮助的人",
    "keyed": "minus",
    "domain": "A",
    "facet": 6,
    "ipipId": [
      "E166"
    ]
  },
  {
    "id": "ea3327ea-3529-4be4-8e2d-2174731ae4d7",
    "text": "做事不经过思考",
    "keyed": "minus",
    "domain": "C",
    "facet": 6,
    "ipipId": [
      "H846"
    ]
  }
]
