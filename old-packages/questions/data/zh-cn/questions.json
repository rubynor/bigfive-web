[
  {
    "id": "43c98ce8-a07a-4dc2-80f6-c1b2a2485f06",
    "text": "为很多事情感到担心",
    "keyed": "plus",
    "domain": "N",
    "facet": 1,
    "ipipId": [
      "H1157",
      "X5"
    ]
  },
  {
    "id": "d50a597f-632b-4f7b-89e6-6d85b50fd1c9",
    "text": "很容易交到朋友",
    "keyed": "plus",
    "domain": "E",
    "facet": 1,
    "ipipId": [
      "H29"
    ]
  },
  {
    "id": "888dd864-7449-4e96-8d5c-7a439603ea91",
    "text": "有丰富的想象力",
    "keyed": "plus",
    "domain": "O",
    "facet": 1,
    "ipipId": [
      "X14"
    ]
  },
  {
    "id": "ce2fbbf8-7a97-4199-bda5-117e4ecdf3b6",
