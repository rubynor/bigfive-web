[
  {
    "id": "43c98ce8-a07a-4dc2-80f6-c1b2a2485f06",
    "text": "為很多事情感到擔憂",
    "keyed": "plus",
    "domain": "N",
    "facet": 1,
    "ipipId": [
      "H1157",
      "X5"
    ]
  },
  {
    "id": "d50a597f-632b-4f7b-89e6-6d85b50fd1c9",
    "text": "很容易結交朋友",
    "keyed": "plus",
    "domain": "E",
    "facet": 1,
    "ipipId": [
      "H29"
    ]
  },
  {
    "id": "888dd864-7449-4e96-8d5c-7a439603ea91",
    "text": "有豐富的想像力",
    "keyed": "plus",
    "domain": "O",
    "facet": 1,
    "ipipId": [
      "X14"
    ]
  },
  {
    "id": "ce2fbbf8-7a97-4199-bda5-117e4ecdf3b6",
    "text": "信任他人",
    "keyed": "plus",
    "domain": "A",
    "facet": 1,
    "ipipId": [
      "H113",
      "X6"
    ]
  },
  {
    "id": "c7f53c3c-2e77-432f-bb71-7470b67d3aa9",
    "text": "能成功完成任務",
    "keyed": "plus",
    "domain": "C",
    "facet": 1,
    "ipipId": [
      "H1285"
    ]
  },
  {
    "id": "48ad12ce-470e-4339-90ac-ea8c43a0103e",
    "text": "很容易生氣",
    "keyed": "plus",
    "domain": "N",
    "facet": 2,
    "ipipId": [
      "H754",
      "X18"
    ]
  },
  {
    "id": "458f3957-2359-4077-ade1-34525d633063",
    "text": "喜歡參加大型聚會",
    "keyed": "plus",
    "domain": "E",
    "facet": 2,
    "ipipId": [
      "H78",
      "X17"
    ]
  },
  {
    "id": "58d571e5-d725-4cf8-a438-32c16ee28eb6",
    "text": "相信藝術的重要性",
    "keyed": "plus",
    "domain": "O",
    "facet": 2,
    "ipipId": [
      "X123"
    ]
  },
  {
    "id": "0cf79e27-e702-45c2-9471-04ac96b58e0e",
    "text": "利用他人達成自己的目的",
    "keyed": "minus",
    "domain": "A",
    "facet": 2,
    "ipipId": [
      "H416",
      "X24"
    ]
  },
  {
    "id": "cda1ca17-b599-4561-a6cd-ff9d36062d27",
    "text": "喜歡整理",
    "keyed": "plus",
    "domain": "C",
    "facet": 2,
    "ipipId": [
      "H244",
      "X21"
    ]
  },
  {
    "id": "5e8550d7-b8ef-4905-950a-f81d735d39e2",
    "text": "經常感到憂鬱",
    "keyed": "plus",
    "domain": "N",
    "facet": 3,
    "ipipId": [
      "X74"
    ]
  },
  {
    "id": "8af754f2-68e9-48f3-8c5d-2e6633d4472c",
    "text": "會主導局面",
    "keyed": "plus",
    "domain": "E",
    "facet": 3,
    "ipipId": [
      "H334",
      "X27"
    ]
  },
  {
    "id": "0727def6-3d18-4221-bf38-86b58f9f3eed",
    "text": "情緒感受很強烈",
    "keyed": "plus",
    "domain": "O",
    "facet": 3,
    "ipipId": [
      "X92"
    ]
  },
  {
    "id": "ccf3a5c8-fb50-4bd4-8e7a-22af3d657279",
    "text": "喜歡幫助別人",
    "keyed": "plus",
    "domain": "A",
    "facet": 3,
    "ipipId": [
      "H1108"
    ]
  },
  {
    "id": "73d84e5d-cbf5-47f0-b8cb-4d2159a52e32",
    "text": "遵守承諾",
    "keyed": "plus",
    "domain": "C",
    "facet": 3,
    "ipipId": [
      "H149",
      "X33",
      "V14"
    ]
  },
  {
    "id": "b2d9ef74-73f5-4ea8-b00c-7aaca15937df",
    "text": "很難主動接近別人",
    "keyed": "plus",
    "domain": "N",
    "facet": 4,
    "ipipId": [
      "H592"
    ]
  },
  {
    "id": "48a761ef-438e-409b-ae59-ea2ce8f84414",
    "text": "總是很忙碌",
    "keyed": "plus",
    "domain": "E",
    "facet": 4,
    "ipipId": [
      "H58"
    ]
  },
  {
    "id": "cae55842-8957-4e3b-83b3-ceff98fb9dcf",
    "text": "喜歡變化，不喜歡一成不變",
    "keyed": "plus",
    "domain": "O",
    "facet": 4,
    "ipipId": [
      "X204"
    ]
  },
  {
    "id": "e2028ad3-b128-4f76-be57-398bfe2aff22",
    "text": "喜歡跟人起衝突",
    "keyed": "minus",
    "domain": "A",
    "facet": 4,
    "ipipId": [
      "H453"
    ]
  },
  {
    "id": "b7fc949b-02b6-4cb9-a3e2-dbb3d824b55f",
    "text": "工作努力",
    "keyed": "plus",
    "domain": "C",
    "facet": 4,
    "ipipId": [
      "H1206",
      "X44"
    ]
  },
  {
    "id": "481efd08-c810-43b1-a952-f8ac9052f96b",
    "text": "經常暴飲暴食",
    "keyed": "plus",
    "domain": "N",
    "facet": 5,
    "ipipId": [
      "X133"
    ]
  },
  {
    "id": "987efee2-899f-4a65-b9b5-1589ef0460d7",
    "text": "喜歡刺激",
    "keyed": "plus",
    "domain": "E",
    "facet": 5,
    "ipipId": [
      "H438",
      "X50"
    ]
  },
  {
    "id": "e1e804c7-4a1d-498f-8610-f95147af9d1d",
    "text": "喜歡閱讀有挑戰性的內容",
    "keyed": "plus",
    "domain": "O",
    "facet": 5,
    "ipipId": [
      "X211"
    ]
  },
  {
    "id": "71029381-3908-4c68-91e1-e41fb45542a2",
    "text": "認為自己比別人優秀",
    "keyed": "minus",
    "domain": "A",
    "facet": 5,
    "ipipId": [
      "H736",
      "X61"
    ]
  },
  {
    "id": "f6076eea-56ae-4b46-97f1-5f94a7676c96",
    "text": "總是做好準備",
    "keyed": "plus",
    "domain": "C",
    "facet": 5,
    "ipipId": [
      "X87"
    ]
  },
  {
    "id": "2f519935-92e8-48ad-9746-4a0f8b38466a",
    "text": "容易驚慌",
    "keyed": "plus",
    "domain": "N",
    "facet": 6,
    "ipipId": [
      "H948",
      "X64"
    ]
  },
  {
    "id": "899c3f66-51d0-46ea-963a-6fc36d3b3cb9",
    "text": "給人開朗愉快的感覺",
    "keyed": "plus",
    "domain": "E",
    "facet": 6,
    "ipipId": [
      "H32",
      "X63"
    ]
  },
  {
    "id": "79186f48-e7fa-4df4-b74b-b0627ee244e1",
    "text": "認為自己在政治上自由開放",
    "keyed": "plus",
    "domain": "O",
    "facet": 6,
    "ipipId": [
      "X218"
    ]
  },
  {
    "id": "fd50e1ca-d9e0-4037-a7a1-a191d4db2d96",
    "text": "同情無家可歸者",
    "keyed": "plus",
    "domain": "A",
    "facet": 6,
    "ipipId": [
      "X259"
    ]
  },
  {
    "id": "bd9eec0a-b68b-472c-8803-7db29c308cdb",
    "text": "不經思考就貿然行動",
    "keyed": "minus",
    "domain": "C",
    "facet": 6,
    "ipipId": [
      "E46"
    ]
  },
  {
    "id": "7f92ab2c-265c-4b84-8c74-09f9bb9d41a7",
    "text": "擔心會發生最壞的情況",
    "keyed": "plus",
    "domain": "N",
    "facet": 1,
    "ipipId": [
      "H999"
    ]
  },
  {
    "id": "af55f014-788c-4b6e-92c4-b2b59dc8a28d",
    "text": "在人群中感到自在",
    "keyed": "plus",
    "domain": "E",
    "facet": 1,
    "ipipId": [
      "X112"
    ]
  },
  {
    "id": "08ff6dca-02a5-4aeb-aaa4-2ecf2526f143",
    "text": "喜歡天馬行空地幻想",
    "keyed": "plus",
    "domain": "O",
    "facet": 1,
    "ipipId": [
      "X238"
    ]
  },
  {
    "id": "6f66cdc0-9044-457b-b40d-501ecae15ee7",
    "text": "相信別人有好意",
    "keyed": "plus",
    "domain": "A",
    "facet": 1,
    "ipipId": [
      "H549"
    ]
  },
  {
    "id": "f110fc66-2e9e-413c-920b-19f05e63d7ac",
    "text": "在自己所從事的領域出類拔萃",
    "keyed": "plus",
    "domain": "C",
    "facet": 1,
    "ipipId": [
      "H1174",
      "X8"
    ]
  },
  {
    "id": "7dab2a37-8635-4fc7-86b7-0abf13c183c9",
    "text": "容易被激怒",
    "keyed": "plus",
    "domain": "N",
    "facet": 2,
    "ipipId": [
      "H761"
    ]
  },
  {
    "id": "28ab59a0-e7cd-4fce-94e3-bba2ecc023b6",
    "text": "在派對上和很多人聊天",
    "keyed": "plus",
    "domain": "E",
    "facet": 2,
    "ipipId": [
      "X83"
    ]
  },
  {
    "id": "b5919f2f-cded-4745-a9ce-c02703cee807",
    "text": "看到別人可能注意不到的美",
    "keyed": "plus",
    "domain": "O",
    "facet": 2,
    "ipipId": [
      "E105"
    ]
  },
  {
    "id": "5a5fa975-d024-4ac8-8845-2823f957c21b",
    "text": "為了成功不擇手段",
    "keyed": "minus",
    "domain": "A",
    "facet": 2,
    "ipipId": [
      "X198"
    ]
  },
  {
    "id": "adf33f9f-45bd-43e3-af25-4c491176d97f",
    "text": "經常忘記把東西放回原處",
    "keyed": "minus",
    "domain": "C",
    "facet": 2,
    "ipipId": [
      "X82"
    ]
  },
  {
    "id": "f0a14e16-d726-47e9-a2c1-647fd3d7d52e",
    "text": "不喜歡自己",
    "keyed": "plus",
    "domain": "N",
    "facet": 3,
    "ipipId": [
      "X15"
    ]
  },
  {
    "id": "0b38e3d3-c15c-454c-b034-f4eb7ae1580a",
    "text": "嘗試領導他人",
    "keyed": "plus",
    "domain": "E",
    "facet": 3,
    "ipipId": [
      "H524"
    ]
  },
  {
    "id": "5631b856-ff34-4f76-a0cd-edc7104c3bfa",
    "text": "感受他人的情緒",
    "keyed": "plus",
    "domain": "O",
    "facet": 3,
    "ipipId": [
      "E136"
    ]
  },
  {
    "id": "ada867af-4db1-4e3d-a604-2b695c1806e5",
    "text": "關心他人",
    "keyed": "plus",
    "domain": "A",
    "facet": 3,
    "ipipId": [
      "H1100",
      "X31"
    ]
  },
  {
    "id": "c55e3958-00c4-4fc3-9118-47d8f31bfde1",
    "text": "會實話實說",
    "keyed": "plus",
    "domain": "C",
    "facet": 3,
    "ipipId": [
      "H145"
    ]
  },
  {
    "id": "acd8fadc-5399-4a67-b5ff-9d1ada049c01",
    "text": "害怕引起注意",
    "keyed": "plus",
    "domain": "N",
    "facet": 4,
    "ipipId": [
      "H655"
    ]
  },
  {
    "id": "d07b6c67-0d02-4948-a997-bb84ac234cd8",
    "text": "總是很活躍",
    "keyed": "plus",
    "domain": "E",
    "facet": 4,
    "ipipId": [
      "H54",
      "X40"
    ]
  },
  {
    "id": "33b81fd0-7e32-4cd8-a13a-d5f5f754f998",
    "text": "喜歡堅持做熟悉的事情",
    "keyed": "minus",
    "domain": "O",
    "facet": 4,
    "ipipId": [
      "X30"
    ]
  },
  {
    "id": "d9a9a180-29c9-4ec5-8621-2256d411def7",
    "text": "對人吼叫",
    "keyed": "minus",
    "domain": "A",
    "facet": 4,
    "ipipId": [
      "H809"
    ]
  },
  {
    "id": "f12c3d9d-1d12-4aa6-ad2e-009cd0651cbb",
    "text": "做得比別人期望的還多",
    "keyed": "plus",
    "domain": "C",
    "facet": 4,
    "ipipId": [
      "H2014"
    ]
  },
  {
    "id": "9891b7ba-a494-4307-aafe-301d8db506c6",
    "text": "很少過度放縱",
    "keyed": "minus",
    "domain": "N",
    "facet": 5,
    "ipipId": [
      "X181"
    ]
  },
  {
    "id": "f1675af6-88bf-4376-a946-0281e762b39c",
    "text": "尋求冒險",
    "keyed": "plus",
    "domain": "E",
    "facet": 5,
    "ipipId": [
      "H446"
    ]
  },
  {
    "id": "95a3f20c-f933-4d19-a2c1-a7dbdf63c562",
    "text": "避免哲學討論",
    "keyed": "minus",
    "domain": "O",
    "facet": 5,
    "ipipId": [
      "X248"
    ]
  },
  {
    "id": "7df44711-4cd4-4b05-8830-73fcc3ebdab5",
    "text": "自我感覺良好",
    "keyed": "minus",
    "domain": "A",
    "facet": 5,
    "ipipId": [
      "H2043"
    ]
  },
  {
    "id": "9d3cb5c7-955c-43a4-b6c7-b07ed01dcbd9",
    "text": "執行自己制定的計劃",
    "keyed": "plus",
    "domain": "C",
    "facet": 5,
    "ipipId": [
      "H258"
    ]
  },
  {
    "id": "13c58810-3864-42ba-aa87-d4166f858756",
    "text": "事情多時會被壓得喘不過氣來",
    "keyed": "plus",
    "domain": "N",
    "facet": 6,
    "ipipId": [
      "H959"
    ]
  },
  {
    "id": "961376e0-16a1-4c14-b059-789e63d11b63",
    "text": "常常玩得很開心",
    "keyed": "plus",
    "domain": "E",
    "facet": 6,
    "ipipId": [
      "H1094"
    ]
  },
  {
    "id": "f08e1b27-3673-4898-9cae-896482d0d9f9",
    "text": "認為沒有絕對的是非對錯",
    "keyed": "plus",
    "domain": "O",
    "facet": 6,
    "ipipId": [
      "X184"
    ]
  },
  {
    "id": "c2038c12-7a37-47a8-9983-831bd6692aab",
    "text": "同情那些比自己境況更糟的人",
    "keyed": "plus",
    "domain": "A",
    "facet": 6,
    "ipipId": [
      "E115"
    ]
  },
  {
    "id": "956f3e17-ff17-4af5-a52f-9222b8968106",
    "text": "做出草率的決定",
    "keyed": "minus",
    "domain": "C",
    "facet": 6,
    "ipipId": [
      "H853"
    ]
  },
  {
    "id": "4d81238b-5407-47d4-88e5-dc0e38aa14f5",
    "text": "害怕很多事情",
    "keyed": "plus",
    "domain": "N",
    "facet": 1,
    "ipipId": [
      "H968"
    ]
  },
  {
    "id": "9f9166f0-fa94-4c14-a91d-3eecd8395794",
    "text": "避免與他人接觸",
    "keyed": "minus",
    "domain": "E",
    "facet": 1,
    "ipipId": [
      "H648"
    ]
  },
  {
    "id": "23a1034f-fab7-4887-a66e-5ef4eaafb25e",
    "text": "喜歡做白日夢",
    "keyed": "plus",
    "domain": "O",
    "facet": 1,
    "ipipId": [
      "X71"
    ]
  },
  {
    "id": "c63e6121-c3ed-40cc-abc2-c1e6ea1e0858",
    "text": "相信別人說的話",
    "keyed": "plus",
    "domain": "A",
    "facet": 1,
    "ipipId": [
      "E157"
    ]
  },
  {
    "id": "02ee1930-36a7-4caa-b10c-c93efb682a44",
    "text": "能順利處理任務",
    "keyed": "plus",
    "domain": "C",
    "facet": 1,
    "ipipId": [
      "H1354"
    ]
  },
  {
    "id": "da8e6ed1-2296-4c58-8fdb-66f2f591989b",
    "text": "發脾氣",
    "keyed": "plus",
    "domain": "N",
    "facet": 2,
    "ipipId": [
      "H755"
    ]
  },
  {
    "id": "03c10b30-b88f-4c63-8acc-71251ca24615",
    "text": "喜歡獨處",
    "keyed": "minus",
    "domain": "E",
    "facet": 2,
    "ipipId": [
      "H587"
    ]
  },
  {
    "id": "751a04bc-5adf-485a-8ea4-4308406ae85b",
    "text": "不喜歡詩歌",
    "keyed": "minus",
    "domain": "O",
    "facet": 2,
    "ipipId": [
      "X45"
    ]
  },
  {
    "id": "982e83c2-d34e-48da-9c71-78494ab05c85",
    "text": "會佔別人便宜",
    "keyed": "minus",
    "domain": "A",
    "facet": 2,
    "ipipId": [
      "H427",
      "V109"
    ]
  },
  {
    "id": "f4891687-0ff0-47af-a4f6-d1202c8f6676",
    "text": "房間裡亂七八糟",
    "keyed": "minus",
    "domain": "C",
    "facet": 2,
    "ipipId": [
      "H822",
      "X16"
    ]
  },
  {
    "id": "743d8973-1de1-4485-91b4-8a5cf63e7d44",
    "text": "經常情緒低落",
    "keyed": "plus",
    "domain": "N",
    "facet": 3,
    "ipipId": [
      "H640"
    ]
  },
  {
    "id": "2452f034-8273-4f71-9122-a40f5ead31ba",
    "text": "掌控局面",
    "keyed": "plus",
    "domain": "E",
    "facet": 3,
    "ipipId": [
      "H325"
    ]
  },
